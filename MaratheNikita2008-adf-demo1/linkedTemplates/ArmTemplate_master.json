{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "MaratheNikita2008-adf-demo1"
		},
		"LS_SQL_DB_SERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_DB_SERVER'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://nikksdb.dfs.core.windows.net/"
		},
		"DemoAzureDataLakeStorage2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://nikksdb.dfs.core.windows.net/"
		},
		"LS_SQL_DB_SERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "nikks-db.database.windows.net"
		},
		"LS_SQL_DB_SERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "nikks-sql-db"
		},
		"LS_SQL_DB_SERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "NikitaMarathe2008"
		},
		"TGR_EVENT_properties_Storage_Trigger_Demo_parameters_File_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/4d23a430-aeb0-44f3-9101-f83c02eca57d/resourceGroups/Nikita_DF/providers/Microsoft.Storage/storageAccounts/nikksdb"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "MaratheNikita2008-adf-demo1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_DB_SERVER_password": {
						"value": "[parameters('LS_SQL_DB_SERVER_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"DemoAzureDataLakeStorage2_properties_typeProperties_url": {
						"value": "[parameters('DemoAzureDataLakeStorage2_properties_typeProperties_url')]"
					},
					"LS_SQL_DB_SERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_DB_SERVER_properties_typeProperties_server')]"
					},
					"LS_SQL_DB_SERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_DB_SERVER_properties_typeProperties_database')]"
					},
					"LS_SQL_DB_SERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_DB_SERVER_properties_typeProperties_userName')]"
					},
					"TGR_EVENT_properties_Storage_Trigger_Demo_parameters_File_name": {
						"value": "[parameters('TGR_EVENT_properties_Storage_Trigger_Demo_parameters_File_name')]"
					},
					"TGR_EVENT_properties_typeProperties_scope": {
						"value": "[parameters('TGR_EVENT_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}