				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check Source Count",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DEMO_WEB_EMAIL",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "Failed",
						"reciepient": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Read Watermark",
				"type": "Lookup",
