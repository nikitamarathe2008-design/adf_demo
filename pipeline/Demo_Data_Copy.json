				"dependsOn": [
					{
						"activity": "Check Source Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DEMO_WEB_EMAIL",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "SUCCESS",
						"reciepient": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute send failure email",
