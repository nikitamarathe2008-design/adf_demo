{
	"name": "FOREACH_DEMO",
	"properties": {
		"activities": [
			{
				"name": "Ingest All table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read List Of Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read List Of Tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Ingestion Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Demo_Data_Copy",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Table Status Success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "Table_Status",
								"value": {
									"value": "@{item().table_name} - Success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Table Status Failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Ingestion Pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "Table_Status",
								"value": {
									"value": "@{item().table_name} - Failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Read List Of Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select table_name from metadata.table_list",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "customers",
							"schema": "dbo"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Send Consolidated Email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Ingest All table",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DEMO_WEB_EMAIL_MULTIPLE",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"reciepient": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						},
						"Table_Status": {
							"value": "@variables('Table_Status')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Fail1",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Ingest All table",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Failed due to previous pipeline",
					"errorCode": "500"
				}
			}
		],
		"variables": {
			"Table_Status": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-12T14:41:28Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}